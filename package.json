{
  "name": "angular-serverless-commerce-dashboard",
  "version": "1.0.0",
  "description": "Angular commerce dashboard powered by an AWS API Gateway and Lambda data proxy.",
  "homepage": "https://itkrivoshei.github.io/angular-serverless-commerce-dashboard/",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:pages": "ng build --configuration production --base-href /angular-serverless-commerce-dashboard/",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/itkrivoshei/angular-serverless-commerce-dashboard.git"
  },
